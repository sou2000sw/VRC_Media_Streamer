# ==============================================================================
# Git Ignore Configuration for VRC_Media_Streamer
# ==============================================================================

# === Python キャッシュ & 仮想環境 ===
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# === 機密情報・資格情報・認証トークン（絶対にコミットしない） ===
.env
.env.*
!.env.example
*token*
*secret*
*credential*
*.key
*.pem
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
cookies.txt
*.cookie

# === ローカル設定ファイル（※テンプレートのみ除外解除） ===
config.json
**/config.json
!config.dist.json
!config.example.json

# === ビルド成果物・一時ディレクトリ・配布バイナリ ===
build/
dist/
dist - */
dist - コピー/
release/
releases/
releases - */
releases - コピー/
plugin/bin/
VRC_Media_Streamer/
*.manifest
*.spec
*.toc
*.pkg
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# 実行ファイル / バイナリ
*.exe
*.dll
*.so
*.dylib
cloudflared.exe
ffmpeg.exe
**/ffmpeg.exe
ffprobe.exe
**/ffprobe.exe
models/

# === 実行時生成データ・ストリーミング一時ファイル・ログ ===
hls_output/
**/hls_output/
*.m3u8
*.ts
*.mp4
*.m4a
*.webm
*.log
logs/
*.log.*

# === IDE・エディタ設定 ===
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# === OS一時ファイル・システム残骸 ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.old

# === 作業用残骸ファイル ===
ag-stop-probe.json
config.yml
standby_test.png

# ビルド時に ui/vendor/ から同期される（正本は ui/vendor/）。
# 1.4MB の第三者バイナリをリポジトリに二重で持たないため除外する。
plugin/ui/vendor/

# GStreamer 開発用ランタイム
.gstreamer_runtime/

# ローカルテストの一時出力
.pytest_temp/
.tmp_diag/pytest_*/
